<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#242235" />
            <stroke android:width="1dp" android:color="#38334D" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#39334F" />
            <stroke android:width="1dp" android:color="#A99BFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#262438" />
            <stroke android:width="1dp" android:color="#514A70" />
        </shape>
    </item>
</selector>
